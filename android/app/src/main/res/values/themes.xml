<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The page paints its own chrome; the platform theme only prevents a white
         flash between launch and first paint. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/boot_bg</item>
        <item name="android:statusBarColor">@color/boot_bg</item>
        <item name="android:navigationBarColor">@color/boot_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
