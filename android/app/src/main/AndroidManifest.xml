<?xml version="1.0" encoding="utf-8"?>
<!--
  Word Atlas · offline edition

  There is intentionally no <uses-permission> element in this manifest — not even
  android.permission.INTERNET. Without it the OS refuses to create sockets for
  this UID, so the app cannot reach the network under any circumstances. All
  content is unpacked from the APK and opened through file:///android_asset.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="tech.wordatlas.app">

    <application
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
